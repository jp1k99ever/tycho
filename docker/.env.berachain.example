# Self-hosted Berachain stack — copy to docker/.env and fill in the RPC endpoints.
# Start with: docker compose --profile substreams-endpoint up
# See docs "Self-Hosted EVM Chain". The RPC poller produces base blocks, so only
# logs-only (native) packages work — which both Everlong packages are.

TYCHO_IMAGE=tycho-indexer:local

# Use a dedicated low-latency node. The public https://rpc.berachain-apis.com
# prunes state after ~10k blocks and serves eth_getLogs inconsistently — fine for
# spot checks, not for indexing.
RPC_URL=<berachain archive rpc>
TRACE_RPC_URL=<berachain archive rpc>

CHAIN_NAME=berachain
CHAINS=berachain
TYCHO_CHAINS_CONFIG=/opt/tycho-indexer/chains.yaml

# CvammALM deployed at 24689006; the CollVault swapper wired at 24689576. Start the
# poller just below the earliest protocol start block.
START_BLOCK=24689000

# Self-hosted Firehose, reachable by its docker service name.
SUBSTREAMS_ENDPOINT=http://substreams-endpoint:10016
SUBSTREAMS_API_TOKEN=local

# Keep no historical state (recommended); the 2000-01-01 default keeps all history
# and breaks a from-scratch backfill.
RETENTION_HORIZON=2100-01-01T00:00:00
